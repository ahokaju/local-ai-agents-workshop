ANTHROPIC_API_KEY=sk-ant-...

# Optional: AWS Bedrock (use instead of or alongside ANTHROPIC_API_KEY)
# Default region is us-east-1. For eu-central-1, change model ID prefixes
# from "us." to "eu." in each *_bedrock.py file you run.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1

# Optional: Atlassian (katas 06-07)
ATLASSIAN_URL=
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=

# Optional: GitHub (kata 08)
GITHUB_TOKEN=
